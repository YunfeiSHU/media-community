# ===========================================================================
# 全项目环境变量示例（Java 体系 + Go 体系共用一份）
#
# 用法：复制成**同目录**的 .env —— Compose 只从「compose 文件所在目录」读 .env，
#       放别处就必须每条命令都加 --env-file，所以模板故意和 compose*.yml 放一起。
#
#     Copy-Item deploy\.env.example deploy\.env
#
# 所有变量都有内置默认值（见 deploy/compose*.yml 的 ${X:-默认}），因此 .env
# 不是必须的。下面列出的默认值 = **本机现状**：MySQL/Redis 装在宿主机上，
# RabbitMQ/MinIO/Nacos 是手工起的容器（`docker ps` 可见）。
#
# 注意：这里只管「容器怎么连依赖」。直接在宿主机上 `go run` / `mvn spring-boot:run`
# 时读的是各服务自己的 configs/config.yaml 或 application.yml，与本文件无关。
# ===========================================================================

# ======================== 1. 中间件地址（两种模式二选一） ========================
#
# 模式 A（默认，本机现状）：中间件在宿主机上 → 容器用 host.docker.internal 回连
INFRA_MYSQL_HOST=host.docker.internal
INFRA_MYSQL_PORT=3306
INFRA_REDIS_HOST=host.docker.internal
INFRA_REDIS_PORT=6379
INFRA_RABBITMQ_HOST=host.docker.internal
INFRA_RABBITMQ_PORT=5672
INFRA_MINIO_ENDPOINT=host.docker.internal:9000
INFRA_NACOS_ADDR=host.docker.internal:8848
INFRA_SRS_API_BASE=http://host.docker.internal:1985

# 模式 B（`docker compose --profile infra up -d` 自建中间件时）：
# 把上面 8 行整体换成下面这 8 行 —— 容器之间走 Compose 服务名，端口用容器端口。
#
# INFRA_MYSQL_HOST=mysql
# INFRA_MYSQL_PORT=3306
# INFRA_REDIS_HOST=redis
# INFRA_REDIS_PORT=6379
# INFRA_RABBITMQ_HOST=rabbitmq
# INFRA_RABBITMQ_PORT=5672
# INFRA_MINIO_ENDPOINT=minio:9000
# INFRA_NACOS_ADDR=nacos:8848
# INFRA_SRS_API_BASE=http://srs:1985

# ---- 中间件在**宿主机**上暴露的端口（只影响端口映射，不影响容器互联）----
MYSQL_HOST_PORT=3307          # 自建 MySQL 用 3307，避开宿主机已有 MySQL 的 3306
REDIS_HOST_PORT=6380          # 同理，避开宿主机的 6379
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9090  # 控制台不能用 9001（宿主上已有 minio 占了）
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848     # Nacos 2.x 客户端必需 = 8848 + 1000
SRS_RTMP_HOST_PORT=1936
SRS_HTTP_HOST_PORT=8088
SRS_API_HOST_PORT=1986
SRS_WEBRTC_HOST_PORT=8001

# 给浏览器的推流 / 播放地址里用的主机名（必须是宿主机视角，不能用服务名）
PUBLIC_HOST=localhost

# ==================== 2. 共用凭据（Java 与 Go 用同一套库/实例） ====================
# MySQL：必须与 auth-service/src/main/resources/application.yml 的
#        SPRING_DATASOURCE_PASSWORD 一致，否则 Java 侧连不上自己建的库
SHARED_MYSQL_USER=root
SHARED_MYSQL_PASSWORD=change-me    # 本地开发口令；真实口令不要写进仓库
SHARED_MYSQL_DATABASE=auth_service

# Redis：宿主机那套没有设密码，自建模式（compose.infra.yml）也刻意不设密码，
#        两边保持一致 —— 否则会出现「只在自建模式下连不上」这类偏移
SHARED_REDIS_PASSWORD=

# RabbitMQ / MinIO（Go 体系独有，Java 侧没有 MQ / 对象存储）
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin
RABBITMQ_VHOST=/
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MEDIA_BUCKET=media

# 其它
PAYMENT_CALLBACK_SECRET=order-service-callback-secret

# ================= 3. 网关如何找到 Go 三服务（compose.java.yml） =================
# Go 三服务**没有接入 Nacos**（见 docs/Go微服务-公共约定.md），网关对它们是直连 uri
# 而不是 lb://，所以地址必须显式给出。compose.java.yml 里这三项的默认值是
# **服务名**（video-service / live-service / danmaku-service）—— 因为 compose.yml
# 用 include 把三组服务合成同一个 Compose 项目（media-stack），容器之间可以直接
# 用服务名互访。
#
# 只有「Go 服务跑在宿主机上、没进 Compose」时才需要在这里覆盖：
#   VIDEO_SERVICE_URI=http://host.docker.internal:9001
#   LIVE_SERVICE_URI=http://host.docker.internal:9002
#   DANMAKU_SERVICE_URI=http://host.docker.internal:9003
#
# 相应地在宿主机直接 `go run` / `mvn spring-boot:run` 时不走 .env，
# 网关用的是 application.yml 的默认值 http://localhost:900X，本来就对。
#
# VIDEO_SERVICE_URI=http://video-service:9001
# LIVE_SERVICE_URI=http://live-service:9002
# DANMAKU_SERVICE_URI=http://danmaku-service:9003
DANMAKU_WS_ORIGINS=*

# ========================= 3. 运行模式与能力开关 =========================
APP_ENV=local
# mock = 不调用真实二进制，只模拟进度与产物（默认，便于无依赖启动）
# real = 调用真实 ffmpeg / SRS API
#
# ⚠️ 演示/作品集环境必须用 real：
#    mock 只生成「结构正确但没有分片」的 m3u8，播放器会一直转圈，看起来像前端 bug。
#    切 real 前先确认容器/宿主机里能直接执行 `ffmpeg -version`。
#      - 本机：装 FFmpeg 并加入 PATH；
#      - 容器：video-service 的 Dockerfile 需基于带 ffmpeg 的镜像（或挂载二进制）。
VIDEO_TRANSCODER_DRIVER=mock
# LIVE_MEDIA_DRIVER 同理：mock 只造状态，不会真的连 SRS
LIVE_MEDIA_DRIVER=mock

# ========================= 4. 安全与服务开关 =========================
# auth 与 gateway 必须用同一把；本地用默认值即可，生产务必换成随机值
# 生成：openssl rand -base64 48
JWT_SECRET=dev-only-jwt-secret-please-change-in-production-0123456789
# 支付回调校验；生产与渠道后台一致
PAYMENT_CALLBACK_SECRET=order-service-callback-secret
# 演示用模拟支付：生产必须 false
MOCK_PAY_ENABLED=true
# 验证码回显：生产必须 false
AUTH_VERIFICATION_EXPOSE_CODE=true
# 浏览器实际访问的 scheme/host（同源反代时用于拼绝对 URL）
PUBLIC_SCHEME=http
# 转码临时目录（容器内）
VIDEO_WORK_DIR=/tmp/transcode
