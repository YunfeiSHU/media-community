# 统一以 LF 入库，避免 Windows 上 core.autocrlf 造成的换行符抖动。
* text=auto eol=lf

# Windows 脚本保留 CRLF（双击/记事本/部分 PowerShell 场景更稳）
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制：不要做换行或编码转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
