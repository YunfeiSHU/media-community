# =============================================================================
# 生产环境变量模板（复制为 deploy/.env.production，然后：
#   docker compose --env-file .env.production --profile java --profile infra --profile media up -d
# 或先 `export` 成进程环境变量再起服务）
#
# ★ 安全要求
#   1. 本文件里的 `change-me-*` 全部换成随机值（≥32 字节），不要提交真实密钥；
#   2. 更推荐用 Vault / K8s Secret / 云密钥管理注入，而不是把 .env 放服务器磁盘；
#   3. `.env.production` 权限 600，且加入 .gitignore。
# =============================================================================

# ---------------------------------------------------------------- 对外地址
# 浏览器最终访问的源；Nginx 同源反代下所有绝对 URL 都必须用它
PUBLIC_SCHEME=https
PUBLIC_HOST=your.site
# 媒体/直播回给浏览器的前缀（Nginx 会剥掉 /media、/live）
VIDEO_MINIO_PUBLIC_ENDPOINT=https://your.site/media
LIVE_PUBLIC_BASE=https://your.site/live
DANMAKU_WS_ORIGINS=https://your.site

# ---------------------------------------------------------------- MySQL
MYSQL_HOST_PORT=3307
SHARED_MYSQL_USER=media_app
SHARED_MYSQL_PASSWORD=change-me-strong-db-password
SHARED_MYSQL_DATABASE=auth_service
# 仅 compose 初始化容器时使用（应用连接用上面的 SHARED_MYSQL_*）
MYSQL_ROOT_PASSWORD=change-me-root-password

# ---------------------------------------------------------------- Redis
REDIS_HOST_PORT=6380
SHARED_REDIS_PASSWORD=change-me-redis-password

# ---------------------------------------------------------------- RabbitMQ
RABBITMQ_HOST_PORT=5672
RABBITMQ_MGMT_HOST_PORT=15672
RABBITMQ_USER=media_mq
RABBITMQ_PASSWORD=change-me-mq-password
RABBITMQ_VHOST=/

# ---------------------------------------------------------------- MinIO
MINIO_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9090
MINIO_ROOT_USER=media_minio
MINIO_ROOT_PASSWORD=change-me-minio-password
MEDIA_BUCKET=media

# ---------------------------------------------------------------- Nacos
NACOS_HOST_PORT=8848
NACOS_GRPC_HOST_PORT=9848
# Nacos 默认口令必须改；开启鉴权后同步到 NACOS_USERNAME/NACOS_PASSWORD
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me-nacos-password

# ---------------------------------------------------------------- JWT / 支付
# auth 与 gateway 必须用同一把；建议 openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-bytes-random-secret
# 支付渠道异步回调校验，必须与渠道后台一致
PAYMENT_CALLBACK_SECRET=change-me-payment-callback-secret

# ---------------------------------------------------------------- 业务开关（生产必须）
# 演示用模拟支付：生产必须 false，否则任何人可白嫖订单
MOCK_PAY_ENABLED=false
# 验证码回显：生产必须 false
AUTH_VERIFICATION_EXPOSE_CODE=false
# 转码：生产用 real；mock 产物没有分片，播放器会一直转圈
VIDEO_TRANSCODER_DRIVER=real
VIDEO_WORK_DIR=/var/lib/media/transcode

# ---------------------------------------------------------------- SRS / 推流
# RTMP 必须对公网开放（OBS 直推）；其余只绑回环
SRS_RTMP_HOST_PORT=1936
SRS_HTTP_HOST_PORT=8088
SRS_API_HOST_PORT=1986
# 注意：不能再用默认 8001（会与 user-service 冲突）
SRS_WEBRTC_HOST_PORT=8100
LIVE_MEDIA_DRIVER=srs
LIVE_SRS_APP=live

# ---------------------------------------------------------------- 容器内互连（同 Compose 项目用服务名）
INFRA_MYSQL_HOST=mysql
INFRA_MYSQL_PORT=3306
INFRA_REDIS_HOST=redis
INFRA_REDIS_PORT=6379
INFRA_RABBITMQ_HOST=rabbitmq
INFRA_RABBITMQ_PORT=5672
INFRA_MINIO_ENDPOINT=minio:9000
INFRA_NACOS_ADDR=nacos:8848
INFRA_SRS_API_BASE=http://srs:1985
